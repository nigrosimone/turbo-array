{
  "name": "turbo-array",
  "version": "1.3.0",
  "description": "Turbo Array is a lightweight, high-performance, fast library that allows you to build lazy evaluation pipelines for arrays.",
  "main": "build/main/index.js",
  "typings": "build/main/index.d.ts",
  "module": "build/module/index.js",
  "repository": "https://github.com/nigrosimone/turbo-array",
  "license": "MIT",
  "keywords": [
    "array",
    "fast",
    "turbo",
    "performance"
  ],
  "scripts": {
    "build": "run-p build:*",
    "build:main": "tsc -p tsconfig.json",
    "build:module": "tsc -p tsconfig.module.json",
    "fix": "run-s fix:*",
    "fix:prettier": "prettier \"{src,example,benchmark,playground}/**/*.ts\" --write",
    "fix:lint": "eslint . --fix",
    "test": "run-s build test:*",
    "test:lint": "eslint .",
    "test:prettier": "prettier \"{src,example,benchmark,playground}/**/*.ts\" --list-different",
    "test:spelling": "cspell \"{README.md,.github/**/*.md,src/**/*.ts,example/**/*.ts}\"",
    "test:types": "tsc -p tsconfig.spec.json",
    "test:unit": "vitest run",
    "watch:build": "tsc -p tsconfig.json -w",
    "watch:test": "vitest",
    "cov": "run-s cov:check cov:open",
    "cov:check": "vitest run --coverage",
    "cov:open": "open-cli coverage/index.html",
    "doc": "run-s doc:html doc:open",
    "doc:html": "typedoc src/index.ts --out build/docs",
    "doc:open": "open-cli build/docs/index.html",
    "doc:json": "typedoc src/index.ts --json build/docs/typedoc.json",
    "doc:publish": "gh-pages -m \"[ci skip] Updates\" -d build/docs",
    "reset-hard": "git clean -dfx && git reset --hard && npm i",
    "prepare-release": "run-s reset-hard test cov:check doc:html release doc:publish",
    "bench": "tsx benchmark/benchmark.ts",
    "example": "tsx watch example/index.ts",
    "dev": "tsx watch --inspect=9222 playground/index.ts",
    "release": "release-it"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/benchmark": "^2.1.5",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "benchmark": "^2.1.4",
    "cspell": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "gh-pages": "^6.3.0",
    "npm-run-all2": "^9.0.2",
    "open-cli": "^9.0.0",
    "prettier": "^3.9.6",
    "release-it": "^20.2.1",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "files": [
    "build/main",
    "build/module",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "prettier": {
    "singleQuote": true,
    "printWidth": 180
  }
}